# Copy this to .env and fill in your values
# cp .env.example .env

# Kafka (local Docker)
KAFKA_BOOTSTRAP=localhost:9092

# Postgres (local Docker — no changes needed)
PG_HOST=localhost
PG_USER=nithya
PG_PASSWORD=pipeline123
PG_DB=sentiment_db

# Redis (local Docker — no changes needed)
REDIS_HOST=localhost

# Reddit API (free — get from https://www.reddit.com/prefs/apps)
# 1. Go to the link above
# 2. Click "create another app"
# 3. Choose "script"
# 4. Name it anything (e.g. "market-sentiment-bot")
# 5. Copy client_id (under app name) and client_secret
REDDIT_CLIENT_ID=your_client_id_here
REDDIT_CLIENT_SECRET=your_client_secret_here
